# --- environments and caches -----------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
.venv_pointpillars/
.micromamba/
bin/
.gen/
.streamlit/secrets.toml
.claude/

# --- viewer state ----------------------------------------------------------
.matsense_viewer.pid
.streamlit_app.pid
viewer_command.txt

# --- experiment output ------------------------------------------------------
# Point clouds, frames and campaign logs: hundreds of gigabytes, regenerated by
# running the scripts.
*.log
nohup.out
output_dataset/
bundled_toolkit/scripts/output_dataset/
archivio_campagne/
logs_*/
rq4_logs_*/
*_logs/

# --- everything that is not the tool ----------------------------------------
# This repository holds the MatSense tool: the dashboard, the CARLA runtime and
# the material-aware LiDAR response. Everything used to RUN and ANALYSE an
# experiment campaign lives on disk and is distributed as a replication package
# instead, so the checkout stays small and obvious to navigate.
# Anchored with a leading slash: an unanchored `scripts/` also matches
# bundled_toolkit/scripts/, which is the runtime and must stay.
/analysis/
/paper/
/design/
/drafts/
/PR_BODY.md
/scripts/
/tools/
/scenarios/
/scenarios_official/
/recordings/
/PCLA/
/*.ps1
/parked_*.json
docs/ADAS_*
docs/REPLICATION_PACKAGE_TUTORIAL.md
docs/threats_to_validity_draft.md
docs/RQ4_E5_RESULTS.md

# --- preview videos ---------------------------------------------------------
# Tens of megabytes per scenario, regenerated by tools/record_scenario_preview.py.
previews/
previews_top/
previews_trace/
*.mp4
*.webm

# --- working backups --------------------------------------------------------
# Many of these sit next to the files they shadow. Useful locally, not in
# history, which already keeps the previous versions.
*.pre_*
*.bak
*.bak_*
*.bak2
*.orig

# --- CARLA runtime libraries ------------------------------------------------
carla_runtime_libs/
xdg-user-dir

# --- large analysis artefacts ------------------------------------------------
# The JSON artefacts under output_analysis/ are small and worth keeping. The
# companion .npz files are not: one cached feature tensor from a single
# open-loop sweep is a hundred megabytes, and it is regenerated by re-running
# the tool that wrote it.
output_analysis/*.npz
output_analysis/*.gif

# --- app demo capture ---------------------------------------------------------
.demo_frames/
